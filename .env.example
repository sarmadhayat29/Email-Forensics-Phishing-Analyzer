# Environment Variables — Example Configuration
# Copy this file to .env and fill in your actual values.
# NEVER commit your real .env file to version control.

# Supabase PostgreSQL Connection String
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Supabase REST API credentials (used by frontend integrations if applicable)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# JWT session signing key — use a strong random secret (e.g. openssl rand -base64 64)
JWT_SECRET=your_jwt_secret_key_here

# --- Live authentication re-verification (optional) ----------------------
# SPF/DKIM/DMARC are re-checked against live DNS by default. Set to false for
# air-gapped deployments; analysis then relies on Authentication-Results headers.
LIVE_AUTH_ENABLED=true

# Per-query DNS timeout in seconds (clamped to 1-15). Every failure degrades to
# header-derived results, so keep this short.
AUTH_DNS_TIMEOUT=4

# --- Domain registration age / newly-registered domains (optional) -------
# Sender and link domains are aged via WHOIS (python-whois) by default. A failed
# lookup is always scored as "unknown" and never as malicious. Set to false for
# air-gapped deployments or if WHOIS (TCP/43) is blocked.
DOMAIN_AGE_ENABLED=true

# Per-domain WHOIS timeout in seconds (clamped to 1-30). The query runs in a
# daemon thread and is abandoned when it overruns.
WHOIS_TIMEOUT=5

# Age in days below which a domain counts as "newly registered" (strong signal).
NRD_DAYS=30

# Age in days below which a domain counts as merely "young" (weak signal).
# Automatically raised to at least NRD_DAYS.
YOUNG_DOMAIN_DAYS=90

# Maximum number of live WHOIS queries per analysed message (clamped to 0-25).
# Cached and brand-owned domains do not count against it.
DOMAIN_AGE_MAX_LOOKUPS=4

# JSON file backing the WHOIS TTL cache. Set to an empty value to keep the cache
# in memory only. The default lives under the gitignored server_reports/ folder;
# on an ephemeral filesystem it is simply rebuilt after a restart.
# WHOIS_CACHE_FILE=
